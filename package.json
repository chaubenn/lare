{
  "name": "lare",
  "private": true,
  "version": "0.1.0",
  "description": "Social progress tracking for LeetCode: log sessions, share demo videos, and get AI-graded mock interviews.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "typescript": "5.9.3"
  }
}
