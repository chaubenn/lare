# Copy the relevant lines into each app's .env.local (never commit real values).

# --- Supabase (public, safe for clients) ---
SUPABASE_URL=https://jndqrvwkwoyvzoqcveev.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# apps/web (Next.js)
NEXT_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=${SUPABASE_PUBLISHABLE_KEY}
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BUNNY_LIBRARY_ID=743884

# apps/desktop (Vite)
VITE_SUPABASE_URL=${SUPABASE_URL}
VITE_SUPABASE_PUBLISHABLE_KEY=${SUPABASE_PUBLISHABLE_KEY}
VITE_SITE_URL=http://localhost:3000
VITE_BUNNY_LIBRARY_ID=743884

# apps/extension (WXT)
WXT_SUPABASE_URL=${SUPABASE_URL}
WXT_SUPABASE_PUBLISHABLE_KEY=${SUPABASE_PUBLISHABLE_KEY}
WXT_SITE_URL=http://localhost:3000

# --- Supabase Edge Function secrets (set with `supabase secrets set`, never in clients) ---
# BUNNY_LIBRARY_ID, BUNNY_STREAM_API_KEY, BUNNY_STREAM_READONLY_KEY, BUNNY_TOKEN_KEY,
